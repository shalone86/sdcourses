{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- "Catalog": every course on one screen. The welcome and the reader's own
      "continue" card, Lesson of the day, then all courses with topic filters and
      a search box. Progress on the cards comes from the reader's browser
      (assets/js/catalog.js); nothing is sent anywhere. --}}
<section class="cc-intro gh-outer">
    <div class="cc-intro-inner gh-inner">
        <div class="cc-intro-text">
            <h1 class="cc-hero-title is-title">{{#if @custom.hero_title}}{{@custom.hero_title}}{{else}}{{@site.title}}{{/if}}</h1>
            {{#if @custom.hero_text}}<p class="cc-hero-text">{{@custom.hero_text}}</p>{{/if}}
            <div class="cc-hero-actions">
                <a class="cc-btn" href="#courses">Browse the courses</a>
                {{#if @site.members_enabled}}{{#unless @member}}
                    <a class="cc-btn cc-btn-quiet" href="#/portal/signup" data-portal="signup">Get new lessons by email</a>
                {{/unless}}{{/if}}
            </div>
        </div>
        {{!-- Filled by catalog.js from the reader's last lesson; stays hidden for first-time visitors --}}
        <div class="cc-resume" data-cc-resume hidden>
            <span class="cc-resume-label">Continue where you left off</span>
            <a class="cc-resume-title" data-cc-resume-link href="#"></a>
            <span class="cc-resume-meta" data-cc-resume-meta></span>
            <div class="cc-bar"><i data-cc-resume-bar></i></div>
            <a class="cc-btn" data-cc-resume-go href="#">Continue</a>
        </div>
    </div>
</section>

{{> "components/lesson-of-the-day"}}

<section class="cc-catalog gh-outer" id="courses" data-cc-catalog data-start="{{@custom.start_here_courses}}">
    <div class="gh-inner">
        <div class="cc-filters" role="group" aria-label="Filter courses">
            <button class="cc-chip" type="button" data-cc-filter="" aria-pressed="true">All</button>
            {{#get "tags" filter="slug:~^'_'+slug:-_courses" limit="all" order="name asc" as |cats|}}
                {{#foreach cats}}<button class="cc-chip" type="button" data-cc-filter="{{slug}}" aria-pressed="false">{{name}}</button>{{/foreach}}
            {{/get}}
            <label class="sr-only" for="cc-search">Search courses and lessons</label>
            <input class="cc-search" id="cc-search" type="search" placeholder="Search courses and lessons" autocomplete="off" data-cc-search>
        </div>
        <p class="cc-count" data-cc-count aria-live="polite"></p>
        <div class="cc-grid">
            {{#get "posts" filter="tag:hash-book" include="tags" limit="all" order="published_at desc" as |courses|}}
                {{#foreach courses}}
                    {{#if primary_tag}}
                        <a class="cc-course" href="{{primary_tag.url}}" data-cc-course="{{primary_tag.slug}}" data-cc-page="{{slug}}" data-cc-cats="{{#foreach tags}}{{slug}} {{/foreach}}" data-cc-text="{{primary_tag.name}} {{title}}">
                            <span class="cc-course-art">
                                {{#if primary_tag.feature_image}}
                                    <img src="{{img_url primary_tag.feature_image size="m"}}" srcset="{{img_url primary_tag.feature_image size="s"}} 320w, {{img_url primary_tag.feature_image size="m"}} 600w" sizes="(max-width: 600px) 92vw, 360px" alt="" loading="lazy">
                                {{/if}}
                                <span class="cc-start-badge" hidden>Start here</span>
                            </span>
                            <span class="cc-course-body">
                                <span class="cc-course-cat">{{#foreach tags}}{{#match slug "~^" "_"}}{{#match slug "!=" "_courses"}}<span>{{name}}</span>{{/match}}{{/match}}{{/foreach}}</span>
                                <span class="cc-course-name">{{primary_tag.name}}</span>
                                <span class="cc-course-meta"><span data-cc-lessons></span><span data-cc-done></span></span>
                                <span class="cc-bar" hidden><i data-cc-bar></i></span>
                            </span>
                        </a>
                    {{/if}}
                {{/foreach}}
            {{/get}}
        </div>
        <p class="cc-empty" data-cc-empty hidden>No course matches that. Try another word, or <button type="button" class="cc-link" data-cc-clear>show every course</button>.</p>
    </div>
</section>

{{> "components/cta"}}
