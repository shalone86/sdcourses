{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{!-- Welcome: what the site is for (Design settings: hero title and text) --}}
{{#if @custom.hero_title}}
    <section class="cc-hero gh-outer">
        <div class="cc-hero-inner gh-inner">
            <h1 class="cc-hero-title is-title">{{@custom.hero_title}}</h1>
            {{#if @custom.hero_text}}
                <p class="cc-hero-text">{{@custom.hero_text}}</p>
            {{/if}}
            <div class="cc-hero-actions">
                {{!-- Ghost gives the real address (this site uses /topic/ for tags) --}}
                {{#get "tags" filter="slug:_courses" limit="1"}}{{#foreach tags}}<a class="cc-btn" href="{{url}}">Browse the courses</a>{{/foreach}}{{/get}}
                {{#if @site.members_enabled}}{{#unless @member}}
                    <a class="cc-btn cc-btn-quiet" href="#/portal/signup" data-portal="signup">Get new lessons by email</a>
                {{/unless}}{{/if}}
            </div>
        </div>
    </section>
{{/if}}

{{> "components/header" headerStyle=@custom.header_style}}

{{> "components/category-list"}}

{{> "components/post-list" feed="home" postFeedStyle=@custom.post_feed_style showTitle=true showSidebar=true}}

{{> "components/tag-cloud"}}

{{> "components/cta"}}
