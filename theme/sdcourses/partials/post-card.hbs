{{!-- A course page (#book) or blog post (#blog) card. Checked with "has", not the first
      internal tag: new course pages carry #lesson before #book. --}}
{{#has tag="#book"}}
    {{> "post-book-card" lazyLoad=lazyLoad post=this}}
{{else has tag="#blog"}}
    {{> "post-blog-card" lazyLoad=lazyLoad post=this}}
{{/has}}
