{{#if @site.members_enabled}}
    {{#unless @member}}
        {{#unless @site.members_invite_only}}
            {{#match @custom.header_style "!=" "Landing"}}
                {{#match @custom.header_style "!=" "Off"}}
                    <section class="gh-cta gh-outer">
                        <div class="gh-cta-inner gh-inner">
                            <div class="gh-cta-content">
                                <h2 class="gh-cta-title is-title">
                                    {{!-- Novel's stock wording is replaced; anything she writes in Design settings wins --}}
                                    {{#match @custom.subscribe_heading "Subscribe to our newsletter"}}
                                        Get updates when new lessons are posted
                                    {{else if @custom.subscribe_heading}}
                                        {{@custom.subscribe_heading}}
                                    {{else}}
                                        {{@site.title}}
                                    {{/match}}
                                </h2>
                                <p class="gh-cta-description is-body">
                                    {{#match @custom.subscribe_subheading "Get the latest news, updates and guides."}}
                                        We'll email you when new courses and lessons go up. It's free, and you can unsubscribe anytime.
                                    {{else if @custom.subscribe_subheading}}
                                        {{@custom.subscribe_subheading}}
                                    {{else}}
                                        {{@site.description}}
                                    {{/match}}
                                </p>
                            </div>
                            {{> "email-subscription" email_field_id="cta-email"}}
                        </div>
                    </section>
                {{/match}}
            {{/match}}
        {{/unless}}
    {{/unless}}
{{/if}}
