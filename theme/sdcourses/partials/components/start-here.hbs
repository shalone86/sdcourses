{{!-- Home page "Start here": a few hand-picked courses (Design settings → Homepage →
      Start here courses, course page slugs). Replaces Novel's one row per category,
      which showed the same course pages again and again. --}}
{{#if @custom.start_here_courses}}
    {{#get "posts" filter="tag:hash-book+slug:[{{@custom.start_here_courses}}]" include="tags,authors" limit="6" as |picks|}}
        {{#if picks}}
            <section class="gh-container is-grid cc-start-here gh-outer">
                <div class="gh-container-inner gh-inner">
                    <h2 class="gh-container-title">Start here</h2>
                    <main class="gh-main">
                        <div class="gh-feed">
                            {{#foreach picks}}
                                {{> "post-book-card" lazyLoad=true post=this}}
                            {{/foreach}}
                        </div>
                    </main>
                </div>
            </section>
        {{/if}}
    {{/get}}
{{/if}}
