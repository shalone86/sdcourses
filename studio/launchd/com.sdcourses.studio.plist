<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Starts the Lesson Studio when Shalone logs in, and restarts it if it stops.
     Installed with: npm run studio-autostart (copies this to ~/Library/LaunchAgents). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sdcourses.studio</string>
  <key>WorkingDirectory</key><string>/Users/shalone/Projects/sdcourses</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>studio/server.mjs</string>
    <string>--no-open</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- ffmpeg and whisper-cli come from Homebrew -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/shalone/Library/Logs/sdcourses-studio.log</string>
  <key>StandardErrorPath</key><string>/Users/shalone/Library/Logs/sdcourses-studio.log</string>
</dict>
</plist>
