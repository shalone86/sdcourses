node_modules/
dist/
# Generated from courses/*/audio by `npm run prepare-lesson`
video/public/*/
!video/public/fonts/
!video/public/covers/

# Cached copies of source pages (fetched by `npm run check`)
courses/*/*/sources/

# Local secrets (Ghost Admin API key)
.env

# Temporary file while a one-take recording is cut into sections
courses/*/*/audio/.take-full.wav

# Ghost theme work (theme/sdcourses is the source)
theme/*.zip
theme/novel-src/
theme/*/node_modules/
theme/*/dist/
theme/*/splashscreens/
theme/.ghost-local/

# Source books kept on this Mac only (copyrighted; not for the public repo)
sources-local/

# Built by the studio on start
studio/player/player.js

# Her camera recordings (video of her face): kept on this Mac only, not in the public repo
courses/*/*/camera/

# Pixel animations she deleted in the studio (kept on this Mac in case she wants one back)
sprites/.deleted/

# Her devices for npm run ship (addresses stay on her computer)
game/devices.json

# Music videos: worked out from the song and its MIDI when needed
songs/*/parts.json
songs/*/song.beats.json
# Her songs (sound and MIDI) stay on this Mac; only the slides file is backed up
songs/*/song.mp3
songs/*/song.wav
songs/*/song.m4a
songs/*/song.aif
songs/*/song.aiff
songs/*/song.mid
