pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- nun game (working title): only
-- her music so far. left/right
-- picks a song to listen to.
-- sfx 0-7: blessed!'s sound effects
-- (the game will reuse them);
-- her songs are written in by
-- npm run music (see the music
-- section of game/nuns/README.md)
songs={{"home screen",8},{"world map",12},{"world map, fast",20}}
song=1
function _update()
 local n=song
 if btnp(0) then song=(song-2)%#songs+1 end
 if btnp(1) then song=song%#songs+1 end
 if n!=song or not playing then
  music(songs[song][2],0,7) playing=true
 end
end
function _draw()
 cls(1)
 print("nun game: music",34,30,10)
 print("\139 "..songs[song][1].." \145",64-(#songs[song][1]+4)*2,60,7)
 print("pattern "..songs[song][2],46,72,6)
end
