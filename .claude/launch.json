        "/Users/shalone/.gemini/antigravity/scratch/picoparish/wrangler.jsonc",
        "--port",
        "8790",
        "--local"
      ],
      "port": 8790
    },
    {
      "name": "studio-test",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "studio/server.mjs",
        "--no-open"
